# Minimal build context for the Dockerfile (R-DEP-04: nothing sensitive or unneeded).

# Secrets and local data: never copied into the image.
.env
.env.*
!.env.example
var/

# Git, CI, hooks and agents: not part of the application.
.git
.gitignore
.gitattributes
.githooks/
.github/
.claude/

# Not needed in the image: tests, evals, scenarios, material and project documents.
tests/
evals/
escenarios/
# material/: only the reglamento corpus read by the knowledge base (R-FUE-01) enters the image.
# Exclude the children of material/ one level deep, then re-include the reglamento folder and
# only its three indexed files (reglamento_academico_2023.md stays out, D-01).
material/*
!material/reglamento
material/reglamento/*
!material/reglamento/reglamento_academico_2025.md
!material/reglamento/evaluacion_y_calificaciones.md
!material/reglamento/bienestar_y_becas.md
SPEC.md
AGENTS.md
CLAUDE.md
FABRICA.md
INTERVENCIONES.md
REPORTE.md
dudas.md
docker-compose.yml

# Build artifacts and local dependencies.
**/bin/
**/obj/
**/TestResults/
**/.vs/
**/node_modules/
**/dist/
