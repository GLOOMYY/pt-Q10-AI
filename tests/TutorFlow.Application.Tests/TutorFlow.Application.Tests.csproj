<Project>
  <!-- Shared settings are imported before the SDK so central package management applies outside src/backend. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\src\backend\Directory.Build.props" />
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\TutorFlow.Application\TutorFlow.Application.csproj" />
    <ProjectReference Include="..\..\src\backend\TutorFlow.Domain\TutorFlow.Domain.csproj" />
    <ProjectReference Include="..\TutorFlow.Testing\TutorFlow.Testing.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
