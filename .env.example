# TutorFlow · variables de entorno (SPEC R-DEP-02).
# Copia este archivo a `.env` (que NO se versiona) y ajusta los valores. Los de aquí son de ejemplo.

# Clave del LLM. OBLIGATORIA: si falta, el backend no arranca y muestra un error claro.
# Valor de ejemplo ficticio; pon tu clave real solo en tu .env local.
LLM_API_KEY=clave-ficticia-de-ejemplo

# Modelo del LLM. Por defecto: gemini-3.1-flash-lite.
LLM_MODEL=gemini-3.1-flash-lite

# Precio en USD por millón de tokens de entrada (R-RES-05). Por defecto: 0.25.
LLM_PRECIO_ENTRADA_USD_MTOK=0.25

# Precio en USD por millón de tokens de salida, razonamiento incluido (R-RES-05). Por defecto: 1.50.
LLM_PRECIO_SALIDA_USD_MTOK=1.50

# URL de la API simulada vista desde el backend. Dentro de los contenedores, localhost no sirve.
# docker-compose.yml ya fija este valor; se documenta aquí por completitud.
MOCK_API_URL=http://mock-api:4000
